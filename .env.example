# Doubao realtime (Vite WS proxy — do NOT prefix with VITE_)
DOUBAO_APP_ID=
DOUBAO_ACCESS_KEY=
DOUBAO_RESOURCE_ID=volc.speech.dialog
DOUBAO_APP_KEY=PlgvMymc7f3tQnJ6

# Doubao TTS voice (speaker id from Volcengine console)
VITE_DOUBAO_SPEAKER=zh_female_vv_jupiter_bigtts

# Dialog persona. Default long prompts live in:
#   src/config/doubao-system-role.txt
#   src/config/doubao-speaking-style.txt
# Uncomment to override those files:
# VITE_DOUBAO_BOT_NAME=豆包
# VITE_DOUBAO_SYSTEM_ROLE=
# VITE_DOUBAO_SPEAKING_STYLE=
# Only set if console enables that model; wrong value often yields 55000001
# VITE_DOUBAO_MODEL=1.2.1.1
# Optional: reuse recent context (~20 QA turns)
# VITE_DOUBAO_DIALOG_ID=

# iFlytek AvatarPlatform (from 虚拟人SDK-Web集成文档)
VITE_IFLYTEK_SERVER_URL=wss://avatar.cn-huadong-1.xf-yun.com/v1/interact
VITE_IFLYTEK_APP_ID=
VITE_IFLYTEK_API_KEY=
VITE_IFLYTEK_API_SECRET=
VITE_IFLYTEK_SCENE_ID=
VITE_IFLYTEK_AVATAR_ID=
VITE_IFLYTEK_VCN=

# Local external RAG (browser → 8787 directly; CORS open)
# VITE_RAG_ENABLED=true
# VITE_RAG_BASE_URL=http://127.0.0.1:8787
# VITE_RAG_TOP_K=2
# VITE_RAG_TIMEOUT_MS=300
